{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pumpoker-texas-multiplayer",
  "main": "server/index.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://eeduuu.github.io,http://127.0.0.1:4176,http://127.0.0.1:4175,http://127.0.0.1:5173,http://localhost:5173"
  },
  "durable_objects": {
    "bindings": [
      { "name": "TEXAS_DIRECTORY", "class_name": "TexasDirectory" },
      { "name": "TEXAS_ROOMS", "class_name": "TexasRoom" }
    ]
  },
  "exports": {
    "TexasDirectory": { "type": "durable-object", "storage": "sqlite" },
    "TexasRoom": { "type": "durable-object", "storage": "sqlite" }
  }
}
